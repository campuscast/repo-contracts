{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://campuscast.local/schemas/sync/ws-inbound",
  "title": "WsInboundMessage",
  "description": "Client → Server WebSocket message envelope for sync protocol",
  "type": "object",
  "required": ["type"],
  "oneOf": [
    {
      "properties": {
        "type": { "const": "ops_batch" },
        "schedule_id": { "type": "string" },
        "ops": {
          "type": "array",
          "items": { "$ref": "https://campuscast.local/schemas/schedule-op" }
        },
        "correlation_id": { "type": "string" }
      },
      "required": ["type", "schedule_id", "ops", "correlation_id"]
    },
    {
      "properties": {
        "type": { "const": "sync_request" },
        "schedule_id": { "type": "string" },
        "correlation_id": { "type": "string" },
        "last_known_operation_id": { "type": "string" }
      },
      "required": ["type", "schedule_id", "correlation_id"]
    },
    {
      "properties": {
        "type": { "const": "heartbeat" },
        "correlation_id": { "type": "string" }
      },
      "required": ["type"]
    }
  ]
}
